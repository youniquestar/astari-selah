<?xml version="1.0" encoding="UTF-8"?>
<robot name="astari_selah">

  <!-- ========================================================================= -->
  <!-- GROUPS: arm (4-DOF positioning) and gripper (1-DOF grasping)              -->
  <!-- ========================================================================= -->
  <group name="arm">
    <chain base_link="base_link" tip_link="tcp_link"/>
  </group>

  <group name="gripper">
    <joint name="joint5_gripper_left"/>
    <joint name="joint5_gripper_right"/>
  </group>

  <!-- ========================================================================= -->
  <!-- GROUP STATES: Named poses for rapid trajectory planning                   -->
  <!-- ========================================================================= -->
  <group_state name="home" group="arm">
    <joint name="joint1_base_yaw" value="1.5708"/>
    <joint name="joint2_shoulder_pitch" value="1.5708"/>
    <joint name="joint3_elbow_pitch" value="0.7854"/>
    <joint name="joint4_wrist_pitch" value="0.0"/>
  </group_state>

  <group_state name="ready" group="arm">
    <joint name="joint1_base_yaw" value="1.5708"/>
    <joint name="joint2_shoulder_pitch" value="1.0472"/>
    <joint name="joint3_elbow_pitch" value="1.2217"/>
    <joint name="joint4_wrist_pitch" value="0.3491"/>
  </group_state>

  <group_state name="extended_cantilever" group="arm">
    <joint name="joint1_base_yaw" value="1.5708"/>
    <joint name="joint2_shoulder_pitch" value="0.0"/>
    <joint name="joint3_elbow_pitch" value="0.0"/>
    <joint name="joint4_wrist_pitch" value="0.0"/>
  </group_state>

  <group_state name="open" group="gripper">
    <joint name="joint5_gripper_left" value="0.7854"/>
  </group_state>

  <group_state name="close" group="gripper">
    <joint name="joint5_gripper_left" value="0.0"/>
  </group_state>

  <!-- ========================================================================= -->
  <!-- END EFFECTOR                                                              -->
  <!-- ========================================================================= -->
  <end_effector name="gripper_eef" parent_link="link4_wrist" group="gripper" parent_group="arm"/>

  <!-- ========================================================================= -->
  <!-- DISABLE COLLISIONS FOR ADJACENT AND PHYSICALLY CONSTRAINED PAIRS           -->
  <!-- ========================================================================= -->
  <disable_collisions link1="base_link" link2="link1_shoulder_yoke" reason="Adjacent"/>
  <disable_collisions link1="link1_shoulder_yoke" link2="link2_upper_arm" reason="Adjacent"/>
  <disable_collisions link1="link2_upper_arm" link2="link3_forearm" reason="Adjacent"/>
  <disable_collisions link1="link3_forearm" link2="link4_wrist" reason="Adjacent"/>
  <disable_collisions link1="link3_forearm" link2="camera_link" reason="Adjacent"/>
  <disable_collisions link1="link4_wrist" link2="gripper_base" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_left_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_base" link2="gripper_right_finger" reason="Adjacent"/>
  <disable_collisions link1="gripper_left_finger" link2="gripper_right_finger" reason="Never"/>
  <disable_collisions link1="base_link" link2="link2_upper_arm" reason="Never"/>

</robot>
