<?xml version="1.0"?>
<robot xmlns:xacro="http://www.ros.org/wiki/xacro">
  <!-- Color definitions matching CAD 3D model specification -->
  <material name="cad_blue">
    <color rgba="0.0 0.27 0.73 1.0"/>
  </material>

  <material name="cad_black">
    <color rgba="0.10 0.10 0.10 1.0"/>
  </material>

  <material name="cad_chrome">
    <color rgba="0.78 0.80 0.82 1.0"/>
  </material>

  <material name="cad_steel">
    <color rgba="0.55 0.57 0.58 1.0"/>
  </material>

  <material name="cad_servo_black">
    <color rgba="0.12 0.12 0.14 1.0"/>
  </material>

  <material name="cad_copper">
    <color rgba="0.85 0.53 0.28 1.0"/>
  </material>
</robot>
